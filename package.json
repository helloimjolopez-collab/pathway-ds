{
  "name": "@helloimjolopez-pathway/pathway-tokens",
  "version": "10.0.4",
  "description": "Pathway Design System tokens \u2014 CSS custom properties, JS export, and DTCG JSON",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "components/sidenav/sidenav.jsx",
    "components/scrollbar/scrollbar.jsx"
  ],
  "main": "./dist/tokens.js",
  "style": "./dist/themes/light.css",
  "exports": {
    ".": "./dist/tokens.js",
    "./json": "./dist/tokens.json",
    "./primitives.css": "./dist/primitives.css",
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/midnight.css": "./dist/themes/midnight.css",
    "./sidenav": "./components/sidenav/sidenav.jsx",
    "./layout.css": "./dist/layout.css",
    "./layout-contextual.css": "./dist/layout-contextual.css",
    "./motion.css": "./dist/motion.css",
    "./breakpoints.css": "./dist/breakpoints.css",
    "./type.css": "./dist/type.css",
    "./contract.json": "./dist/contract.json",
    "./README.md": "./dist/README.md",
    "./layout-responsive.css": "./dist/layout-responsive.css",
    "./brands/newco/primitives.css": "./dist/brands/newco/primitives.css",
    "./brands/newco/themes/light.css": "./dist/brands/newco/themes/light.css",
    "./brands/newco/themes/dark.css": "./dist/brands/newco/themes/dark.css",
    "./brands/newco/layout-contextual.css": "./dist/brands/newco/layout-contextual.css",
    "./css": "./dist/index.css",
    "./brands/newco/css": "./dist/brands/newco/index.css",
    "./brands/newco": "./dist/brands/newco/tokens.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "sync-tokens": "node scripts/sync-tokens.js",
    "sync-motion-tokens": "node scripts/sync-motion-tokens.js",
    "push-tokens": "node scripts/push-tokens.js",
    "sync-and-push": "node scripts/sync-tokens.js && node scripts/push-tokens.js",
    "audit-tokens": "node scripts/audit-tokens.js",
    "fix-tokens": "node scripts/fix-tokens.js",
    "fix-tokens-preview": "node scripts/fix-tokens.js --dry-run",
    "build-tokens": "node scripts/sync-motion-tokens.js && node style-dictionary.config.js && node scripts/stamp-headers.js",
    "build-dist": "node scripts/sync-motion-tokens.js && node style-dictionary.config.js && node scripts/stamp-headers.js && node scripts/check-demo-tokens.js && node scripts/check-token-refs.js && node scripts/check-token-names.js && node scripts/check-token-object-refs.js && node scripts/fix-stale-doc-hex.js --check && node scripts/check-state-distinctness.js && node scripts/check-ladder-order.js && node scripts/check-variant-distinctness.js && node scripts/check-fill-foreground-pairs.js && node scripts/check-story-yield.js && node scripts/check-motion-coverage.js && node scripts/build-dist.js && node scripts/build-index.js && node scripts/build-contract.js && npm run build-elements && npm run sync-demo-module-icon",
    "storybook": "node style-dictionary.config.js && storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check-demo-tokens": "node scripts/check-demo-tokens.js",
    "assemble-export": "node scripts/assemble-figma-export.js",
    "sync-from-figma": "node scripts/assemble-figma-export.js .figma-dump && node scripts/sync-tokens.js && npm run build-dist",
    "figma:parse": "figma connect parse",
    "figma:publish": "figma connect publish",
    "figma:unpublish": "figma connect unpublish",
    "check-secrets": "node scripts/check-secrets.js",
    "check-token-refs": "node scripts/check-token-refs.js",
    "check-token-names": "node scripts/check-token-names.js",
    "check-tokens": "node scripts/check-demo-tokens.js && node scripts/check-token-refs.js && node scripts/check-token-names.js && node scripts/check-token-object-refs.js && node scripts/check-story-yield.js && node scripts/fix-stale-doc-hex.js --check && node scripts/check-motion-coverage.js",
    "build-elements": "esbuild components/sidenav/pathway-sidenav.js --bundle --format=esm --minify --loader:.jsx=jsx --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=dist/pathway-sidenav.js",
    "check-story-yield": "node scripts/check-story-yield.js",
    "stamp-headers": "node scripts/stamp-headers.js",
    "check-headers": "node scripts/stamp-headers.js --check",
    "build-contract": "node scripts/build-contract.js",
    "build-index": "node scripts/build-index.js",
    "check-doc-hex": "node scripts/fix-stale-doc-hex.js --check",
    "check-token-object-refs": "node scripts/check-token-object-refs.js",
    "check-motion-coverage": "node scripts/check-motion-coverage.js",
    "sync-demo-module-icon": "node scripts/sync-demo-module-icon.js"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@figma/code-connect": "^2.0.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react-webpack5": "^8.6.18",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^8.6.18",
    "style-dictionary": "^5.4.0"
  }
}
